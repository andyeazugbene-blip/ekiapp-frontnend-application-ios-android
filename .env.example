# Production backend API base URL.
# Both names are accepted; EXPO_PUBLIC_API_URL is preferred.
EXPO_PUBLIC_API_URL=https://ekiapp-backend.vercel.app
EXPO_PUBLIC_API_BASE_URL=https://ekiapp-backend.vercel.app

# Public production storefront domains.
# Primary domain — used for share links, deep links, and store URLs.
EXPO_PUBLIC_APP_WEBSITE=https://culinarytales.app
EXPO_PUBLIC_APP_DOWNLOAD_LINK=https://culinarytales.app
EXPO_PUBLIC_PUBLIC_WEB_URL=https://culinarytales.app
EXPO_PUBLIC_STORE_BASE_URL=https://culinarytales.app/store
# www alias (must point to the same site).
EXPO_PUBLIC_PUBLIC_WEB_URL_WWW=https://www.culinarytales.app
# Vercel fallback (kept available — DO NOT remove).
EXPO_PUBLIC_VERCEL_FALLBACK_URL=https://ekiapp-backend.vercel.app
EXPO_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADbdUSFvS7twWicQ

# Stripe publishable key (test or live).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YXkYBZjPTymtICNHwFSHX9Hg

# Mock API switch (always false in production).
EXPO_PUBLIC_USE_MOCK_API=false

# App Store / Google Play review-safe subscription mode.
# The app shows backend-derived plan status only.
EXPO_PUBLIC_APP_REVIEW_MODE=true

# Optional — Sentry DSN for error reporting.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENABLE_DEV=false

# Optional — used by scripts/check-domain-links.ts to test a real store route.
TEST_VENDOR_SLUG=
