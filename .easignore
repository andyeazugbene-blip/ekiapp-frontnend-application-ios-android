google-services.json
# Native Gradle build needs the real file in the EAS upload archive — the
# com.google.gms.google-services plugin fails at configuration time without
# it (this is what broke build 49f720c6). This is the client-side Firebase
# config file, not a secret (no private key; API key is SHA1+package
# restricted server-side) — safe for EAS's build sandbox to have it.
!android/app/google-services.json
*.jks
*.keystore
# EAS reads env vars from eas.json's own "env" blocks per build profile —
# these local dotfiles are dev-machine-only and unrelated to what a build
# actually consumes; exclude them from the upload archive on principle
# (their current contents are EXPO_PUBLIC_* publishable values only, but
# a future secret added here shouldn't have to remember this rule).
.env
.env.local
.env.*.local

