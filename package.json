{
  "name": "eki-app",
  "main": "expo-router/entry",
  "version": "1.0.13",
  "scripts": {
    "postinstall": "node scripts/patch-stripe-react-native-ios.js",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:no-mock-data": "node scripts/check-no-mock-data.js",
    "check:no-screenshot-ui": "node scripts/check-no-screenshot-ui.js",
    "check:no-old-domain": "node scripts/check-no-old-domain.js",
    "check:billing-compliance": "node scripts/check-billing-compliance.js",
    "check:release-config": "node scripts/check-release-config.js",
    "check:subscription-backend-contract": "node scripts/check-subscription-backend-contract.js",
    "check:domains": "node scripts/check-domain-links.js",
    "k6:smoke": "k6 run performance/k6/smoke.js",
    "k6:buyer": "k6 run performance/k6/buyer-flow.js",
    "k6:vendor": "k6 run performance/k6/vendor-flow.js",
    "k6:admin": "k6 run performance/k6/admin-readonly.js",
    "k6:rate": "k6 run performance/k6/rate-limit-safe.js",
    "k6:checkout": "k6 run performance/k6/checkout-smoke.js",
