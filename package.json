  "version": "1.0.13",
  "scripts": {
    "postinstall": "node scripts/patch-stripe-react-native-ios.js",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:no-mock-data": "node scripts/check-no-mock-data.js",
